@model Restaurante.Web.DTOs.Users.ActualizarUsuarioDTO

@{
    ViewData["Title"] = "Editar usuario";
}

<div class="container mt-4">

    <h2>Editar usuario</h2>

    <form asp-action="Edit" method="post">

        <input asp-for="Id_Usuario"
               type="hidden" />

        <div asp-validation-summary="All"
             class="text-danger">
        </div>

        <div class="mb-3">
            <label>Nombre</label>
            <input asp-for="Nombre"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Teléfono</label>
            <input asp-for="Telefono"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input asp-for="Email"
                   type="email"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Rol</label>

            <select asp-for="Id_Rol"
                    class="form-select">

                @foreach (var rol in ViewBag.Roles)
                {
                    <option value="@rol.Id_Rol">
                        @rol.Nombre
                    </option>
                }

            </select>

        </div>

        <div class="mb-3">
            <label>Nueva contraseña</label>

            <input asp-for="Password"
                   type="password"
                   class="form-control"
                   placeholder="Dejar vacío para conservarla" />
        </div>

        <div class="form-check mb-3">

            <input asp-for="Activo"
                   class="form-check-input" />

            <label class="form-check-label">
                Usuario activo
            </label>

        </div>

        <button type="submit"
                class="btn btn-success">
            Guardar
        </button>

    </form>

</div>
