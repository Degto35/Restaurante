@model Restaurante.Web.DTOs.Users.CrearUsuarioDTO

@{
    ViewData["Title"] = "Crear usuario";
}

<div class="container mt-4">

    <h2>Crear usuario</h2>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="All"
             class="text-danger">
        </div>

        <div class="mb-3">
            <label>Nombre</label>
            <input asp-for="Nombre"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Teléfono</label>
            <input asp-for="Telefono"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input asp-for="Email"
                   type="email"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Usuario de acceso</label>
            <input asp-for="NombreUsuario"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Contraseña</label>
            <input asp-for="Password"
                   type="password"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Rol</label>

            <select asp-for="Id_Rol"
                    class="form-select">

                <option value="">
                    Seleccione un rol
                </option>

                @foreach (var rol in ViewBag.Roles)
                {
                    <option value="@rol.Id_Rol">
                        @rol.Nombre
                    </option>
                }

            </select>

        </div>

        <button type="submit"
                class="btn btn-success">
            Crear
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>
