@model Restaurante.Web.DTOs.Users.PerfilDTO

@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container mt-4">

    <div class="card">

        <div class="card-body">

            <h2>Mi perfil</h2>

            <form asp-action="EditarPerfil"
                  method="post">

                <div asp-validation-summary="All"
                     class="text-danger">
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Nombre
                    </label>

                    <input asp-for="Nombre"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Teléfono
                    </label>

                    <input asp-for="Telefono"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Guardar cambios
                </button>

            </form>

        </div>

    </div>

</div>
