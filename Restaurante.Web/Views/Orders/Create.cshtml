@model Restaurante.Web.DTOs.Orders.CreateOrderDTO

@{
    ViewData["Title"] = "Nuevo Pedido";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="DiningTableId" class="control-label"></label>
                <select asp-for="DiningTableId" class="form-select" asp-items="Model.Tables">
                    <option value="">-- Seleccione una mesa --</option>
                </select>
                <span asp-validation-for="DiningTableId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="UserId" class="control-label"></label>
                <select asp-for="UserId" asp-validation-for="UserId" class="form-select" asp-items="Model.Users">
                    <option value="">-- Seleccione un mesero --</option>
                </select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Crear Pedido" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}