@using Restaurante.Web.Core.Extensions
@model Restaurante.Web.Core.Pagination.PaginationResponse<Restaurante.Web.DTOs.Orders.OrderDTO>

@{
    ViewData["Title"] = "Pedidos";
}

<h1>@ViewData["Title"]</h1>

<partial name="_Alerts" />

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Pedido</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="RecordsPerPage" class="form-select" onchange="this.form.submit()">
            @foreach (int size in new[] { 5, 10, 15, 30, 50 })
            {
                <option value="@size" selected="@(Model.RecordsPerPage == size)">@size</option>
            }
        </select>
    </div>
    <div class="col">
        <div class="input-group">
            <input type="text" name="Filter" value="@Model.Filter" class="form-control"
                   placeholder="Buscar por número de mesa o por mesero..." />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Mesa</th>
            <th>Mesero</th>
            <th>Estado</th>
            <th class="text-end">Total</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.List.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No se encontraron pedidos.</td>
            </tr>
        }

        @foreach (var item in Model.List)
        {
            <tr>
                <td>@item.Date.ToString("dd/MM/yyyy HH:mm")</td>
                <td>Mesa @item.TableNumber</td>
                <td>@item.UserFullName</td>
                <td><span class="badge @item.Status.ToBadgeClass()">@item.Status.ToDisplayName()</span></td>
                <td class="text-end">@item.Total.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted">Total: @Model.TotalCount pedidos</p>

@if (Model.TotalPages > 1)
{
    <partial name="_PaginationComponent" model="Model" />
}