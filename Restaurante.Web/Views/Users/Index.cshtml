@model Restaurante.Web.Core.Pagination.PaginationResponse<Restaurante.Web.DTOs.Users.UserDTO>

@{
    ViewData["Title"] = "Lista de Usuarios";
}

<h1>@ViewData["Title"]</h1>

<partial name="_Alerts" />

@if (await AccountService.AccountUserIsAuthorizedAsync("users.create"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Crear Nuevo Usuario</a>
    </p>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="RecordsPerPage" class="form-select" onchange="this.form.submit()">
            @foreach (int size in new[] { 5, 10, 15, 30, 50 })
            {
                <option value="@size" selected="@(Model.RecordsPerPage == size)">@size</option>
            }
        </select>
    </div>
    <div class="col">
        <div class="input-group">
            <input type="text" name="Filter" value="@Model.Filter" class="form-control"
                   placeholder="Buscar por nombre, documento, correo o rol..." />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nombre completo</th>
            <th>Documento</th>
            <th>Correo electrónico</th>
            <th>Rol</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @{
            bool canUpdate = await AccountService.AccountUserIsAuthorizedAsync("users.update");
            bool canDelete = await AccountService.AccountUserIsAuthorizedAsync("users.delete");
            string? currentUserId = AccountService.GetCurrentUserId();
        }

        @if (!Model.List.Any())
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No se encontraron usuarios.</td>
            </tr>
        }

        @foreach (var item in Model.List)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.Document</td>
                <td>@item.Email</td>
                <td>@item.RoleName</td>
                <td>
                    @if (canUpdate)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    }

                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a>

                    @if (canDelete && item.Id != currentUserId)
                    {
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Seguro que desea eliminar este usuario?');">
                            <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted">Total: @Model.TotalCount usuarios</p>

@if (Model.TotalPages > 1)
{
    <partial name="_PaginationComponent" model="Model" />
}