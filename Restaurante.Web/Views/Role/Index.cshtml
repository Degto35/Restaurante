@model IEnumerable<Restaurante.Web.DTOs.Role.RoleDTO>

@{
    ViewData["Title"] = "Lista de Roles";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<p><a asp-action="Create" class="btn btn-primary">Crear Nuevo Rol</a></p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nombre del rol</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NameRole</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdRole" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdRole" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>