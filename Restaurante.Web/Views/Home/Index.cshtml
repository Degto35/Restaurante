@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center my-5">
    <h1 class="display-4">Sabor &amp; Tradición</h1>
    <p class="lead text-muted">Sistema de gestión del restaurante</p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Menú</h5>
                <p class="card-text">Administra las categorías y los platos que ofrece el restaurante.</p>
                <a asp-controller="Categorias" asp-action="Index" class="btn btn-primary">Categorías</a>
                <a asp-controller="Platos" asp-action="Index" class="btn btn-outline-primary">Platos</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Personal</h5>
                <p class="card-text">Gestiona los roles y los empleados del restaurante.</p>
                <a asp-controller="Roles" asp-action="Index" class="btn btn-primary">Roles</a>
                <a asp-controller="Empleados" asp-action="Index" class="btn btn-outline-primary">Empleados</a>
            </div>
        </div>
    </div>
</div>