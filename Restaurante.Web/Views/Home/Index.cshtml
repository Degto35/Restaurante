@{
    ViewData["Title"] = "Inicio";

    var profile = await AccountService.GetProfileAsync();
    string name = profile.IsSuccess ? $"{profile.Result!.FirstName} {profile.Result.LastName}" : string.Empty;

    bool canCategories = await AccountService.AccountUserIsAuthorizedAsync("categories.show");
    bool canDishes = await AccountService.AccountUserIsAuthorizedAsync("dishes.show");
    bool canTables = await AccountService.AccountUserIsAuthorizedAsync("tables.show");
    bool canOrders = await AccountService.AccountUserIsAuthorizedAsync("orders.show");
    bool canUsers = await AccountService.AccountUserIsAuthorizedAsync("users.show");
    bool canRoles = await AccountService.AccountUserIsAuthorizedAsync("roles.show");
}

<partial name="_Alerts" />

<section class="hero mb-5">
    <p class="eyebrow mb-2">Cocina con historia</p>
    <h1>Sabor &amp; Tradición</h1>
    <p class="lead mb-4">Bienvenido@(string.IsNullOrWhiteSpace(name) ? "" : ", " + name)</p>

    <div class="d-flex flex-wrap justify-content-center gap-2">
        @if (canOrders)
        {
            <a asp-controller="Orders" asp-action="Index" class="btn btn-warning btn-lg">Ver pedidos</a>
        }
        @if (canTables)
        {
            <a asp-controller="DiningTables" asp-action="Index" class="btn btn-outline-light btn-lg">Ver mesas</a>
        }
    </div>
</section>

<div class="row g-4">
    @if (canCategories || canDishes)
    {
        <div class="col-md-4">
            <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Menú</h5>
                    <p class="card-text text-muted">Categorías y platos que ofrece el restaurante.</p>
                    @if (canCategories)
                    {
                        <a asp-controller="Categories" asp-action="Index" class="btn btn-primary">Categorías</a>
                    }
                    @if (canDishes)
                    {
                        <a asp-controller="Dishes" asp-action="Index" class="btn btn-outline-primary">Platos</a>
                    }
                </div>
            </div>
        </div>
    }

    @if (canTables || canOrders)
    {
        <div class="col-md-4">
            <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Salón</h5>
                    <p class="card-text text-muted">Mesas y pedidos del día.</p>
                    @if (canTables)
                    {
                        <a asp-controller="DiningTables" asp-action="Index" class="btn btn-primary">Mesas</a>
                    }
                    @if (canOrders)
                    {
                        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-primary">Pedidos</a>
                    }
                </div>
            </div>
        </div>
    }

    @if (canUsers || canRoles)
    {
        <div class="col-md-4">
            <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Administración</h5>
                    <p class="card-text text-muted">Usuarios, roles y permisos.</p>
                    @if (canUsers)
                    {
                        <a asp-controller="Users" asp-action="Index" class="btn btn-primary">Usuarios</a>
                    }
                    @if (canRoles)
                    {
                        <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-primary">Roles</a>
                    }
                </div>
            </div>
        </div>
    }
</div>