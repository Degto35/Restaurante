@model Restaurante.Web.Core.Pagination.PaginationResponse<Restaurante.Web.DTOs.Roles.RoleDTO>

@{
    ViewData["Title"] = "Lista de Roles";
}

<h1>@ViewData["Title"]</h1>

<partial name="_Alerts" />

<p>
    <a asp-action="Create" class="btn btn-primary">Crear Nuevo Rol</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="RecordsPerPage" class="form-select" onchange="this.form.submit()">
            @foreach (int size in new[] { 5, 10, 15, 30, 50 })
            {
                <option value="@size" selected="@(Model.RecordsPerPage == size)">@size</option>
            }
        </select>
    </div>
    <div class="col">
        <div class="input-group">
            <input type="text" name="Filter" value="@Model.Filter" class="form-control"
                   placeholder="Buscar por nombre..." />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nombre del rol</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.List.Any())
        {
            <tr>
                <td colspan="2" class="text-center text-muted">No se encontraron roles.</td>
            </tr>
        }

        @foreach (var item in Model.List)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a>

                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Seguro que desea eliminar este rol?');">
                        <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted">Total: @Model.TotalCount roles</p>

@if (Model.TotalPages > 1)
{
    <partial name="_PaginationComponent" model="Model" />
}