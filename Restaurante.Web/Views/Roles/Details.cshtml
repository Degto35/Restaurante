@model Restaurante.Web.DTOs.Roles.RolDTO

@{
    ViewData["Title"] = "Eliminar Rol";
}

<h1>Eliminar Rol</h1>

<h3>¿Estás seguro de que quieres eliminar este rol?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre del rol</dt>
        <dd class="col-sm-10">@Model.NombreRol</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdRol" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>