@model Restaurante.Web.DTOs.Tables.TableDTO

@{
    ViewData["Title"] = "Eliminar Mesa";
}

<h1>Eliminar Mesa</h1>

<h3>¿Estás seguro de que quieres eliminar esta mesa?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Número
        </dt>
        <dd class="col-sm-10">
            Mesa #@Model.Number
        </dd>
        <dt class="col-sm-2">
            Capacidad
        </dt>
        <dd class="col-sm-10">
            @Model.Capacity personas
        </dd>
        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @(Model.IsAvailable ? "Disponible" : "Ocupada")
        </dd>
    </dl>
    
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdTable" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>