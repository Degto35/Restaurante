@model Restaurante.Web.DTOs.Dishes.DishDTO

@{
    ViewData["Title"] = "Eliminar Plato";
}

<h1>Eliminar Plato</h1>

<h3>¿Estás seguro de que quieres eliminar este plato?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Price)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdDish" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>