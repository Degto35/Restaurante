@model Restaurante.Web.Core.Pagination.Abstractions.IPagination

<nav aria-label="Paginación">
    <ul class="pagination justify-content-center">

        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
            <a class="page-link" asp-action="Index"
               asp-route-Page="1"
               asp-route-RecordsPerPage="@Model.RecordsPerPage"
               asp-route-Filter="@Model.Filter">&laquo;</a>
        </li>

        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
            <a class="page-link" asp-action="Index"
               asp-route-Page="@(Model.CurrentPage - 1)"
               asp-route-RecordsPerPage="@Model.RecordsPerPage"
               asp-route-Filter="@Model.Filter">&lsaquo;</a>
        </li>

        @foreach (int pageNumber in Model.Pages)
        {
            <li class="page-item @(Model.CurrentPage == pageNumber ? "active" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-Page="@pageNumber"
                   asp-route-RecordsPerPage="@Model.RecordsPerPage"
                   asp-route-Filter="@Model.Filter">@pageNumber</a>
            </li>
        }

        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            <a class="page-link" asp-action="Index"
               asp-route-Page="@(Model.CurrentPage + 1)"
               asp-route-RecordsPerPage="@Model.RecordsPerPage"
               asp-route-Filter="@Model.Filter">&rsaquo;</a>
        </li>

        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            <a class="page-link" asp-action="Index"
               asp-route-Page="@Model.TotalPages"
               asp-route-RecordsPerPage="@Model.RecordsPerPage"
               asp-route-Filter="@Model.Filter">&raquo;</a>
        </li>
    </ul>
</nav>