<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sabor &amp; Tradición</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:wght@500;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Restaurante.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Sabor &amp; Tradición</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (await AccountService.AccountUserIsAuthorizedAsync("categories.show"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Categories" asp-action="Index">Categorías</a>
                            </li>
                        }
                        @if (await AccountService.AccountUserIsAuthorizedAsync("dishes.show"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dishes" asp-action="Index">Platos</a>
                            </li>
                        }
                        @if (await AccountService.AccountUserIsAuthorizedAsync("tables.show"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DiningTables" asp-action="Index">Mesas</a>
                            </li>
                        }
                        @if (await AccountService.AccountUserIsAuthorizedAsync("orders.show"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="Index">Pedidos</a>
                            </li>
                        }
                        @if (await AccountService.AccountUserIsAuthorizedAsync("users.show"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Users" asp-action="Index">Usuarios</a>
                            </li>
                        }
                        @if (await AccountService.AccountUserIsAuthorizedAsync("roles.show"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Roles" asp-action="Index">Roles</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <a class="nav-link d-flex align-items-center gap-2" asp-controller="Account" asp-action="Profile">
                                    <span class="user-avatar">@((User.Identity.Name ?? "?")[..1].ToUpper())</span>
                                    <span class="text-lowercase">@User.Identity.Name</span>
                                </a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-logout">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer py-3 mt-4">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-1">
            <span><span class="brand">Sabor &amp; Tradición</span> · Cocina con historia</span>
            <span>&copy; 2026 Todos los derechos reservados</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>