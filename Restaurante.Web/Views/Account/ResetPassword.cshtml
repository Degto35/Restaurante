@model Restaurante.Web.DTOs.Account.ResetPasswordDTO

@{
    ViewData["Title"] = "Nueva contraseña";
}

<partial name="_Alerts" />

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <h1 class="h2 mb-2">@ViewData["Title"]</h1>
        <p class="text-muted mb-4">Elige la contraseña nueva para <strong>@Model.Email</strong>.</p>

        <form asp-action="ResetPassword">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="form-group mb-3">
                <label asp-for="NewPassword" class="control-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="ConfirmNewPassword" class="control-label"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>

            <input type="submit" value="Guardar contraseña" class="btn btn-success w-100 py-2" />
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}